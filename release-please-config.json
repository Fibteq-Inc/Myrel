{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": true,
  "packages": {
    "apps/desktop": {
      "release-type": "simple",
      "component": "desktop",
      "package-name": "desktop",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        }
      ]
    },
    "apps/mobile": {
      "release-type": "node",
      "component": "mobile",
      "package-name": "@myrel/mobile",
      "extra-files": [
        {
          "type": "generic",
          "path": "app.config.ts"
        }
      ]
    }
  }
}
