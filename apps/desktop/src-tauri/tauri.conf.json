{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Myrel",
  "identifier": "io.fibteq.myrel",
  "build": {
    "beforeDevCommand": "node scripts/build-runner.mjs && pnpm exec vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-runner.mjs && pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Myrel",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "backgroundColor": "#0e0e10",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: https: http:",
        "media-src": "'self' data: blob: https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http: wss: ws:",
        "frame-src": "'self' https: http:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Projects with AI teammates",
    "copyright": "© Fibteq",
    "publisher": "Fibteq",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "externalBin": [
      "binaries/myrel-runner"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "myrel"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/Fibteq-Inc/myrel/releases/latest/download/latest.json"
      ]
    }
  }
}
