{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Altair",
  "identifier": "io.fibteq.altair",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Altair",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "backgroundColor": "#0e0e10",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Projects with AI teammates",
    "copyright": "© Fibteq",
    "publisher": "Fibteq",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": { "depends": [] }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["altair"] }
    },
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/Fibteq-Inc/altair/releases/latest/download/latest.json"]
    }
  }
}
