{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Myrel UI may call in the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "fs:allow-read-file",
    "notification:default",
    "opener:allow-open-url",
    "process:allow-restart",
    "store:default",
    "updater:default"
  ]
}
