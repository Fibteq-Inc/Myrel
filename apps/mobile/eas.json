{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_MYREL_SERVER": "https://myrel.fibteq.io"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_MYREL_SERVER": "https://myrel.fibteq.io"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6824902999",
        "metadataPath": "./store.config.js"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
