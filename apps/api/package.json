{
  "name": "@altair/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --containers-rollout=none --outdir dist",
    "deploy": "wrangler d1 migrations apply altair --remote && wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "typecheck": "tsc",
    "test": "vitest run",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false"
  },
  "dependencies": {
    "@altair/db": "workspace:*",
    "@altair/protocol": "workspace:*",
    "@altair/runner-core": "workspace:*",
    "agents": "0.28.1",
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261019.1",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
