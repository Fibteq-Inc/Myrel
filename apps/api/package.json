{
  "name": "@myrel/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "WRANGLER_CI_OVERRIDE_NETWORK_MODE_HOST=1 wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler d1 migrations apply myrel --remote && WRANGLER_CI_OVERRIDE_NETWORK_MODE_HOST=1 wrangler deploy",
    "deploy:preview": "WRANGLER_CI_OVERRIDE_NETWORK_MODE_HOST=1 wrangler versions upload",
    "deploy:hosted": "wrangler d1 migrations apply myrel --remote && WRANGLER_CI_OVERRIDE_NETWORK_MODE_HOST=1 wrangler deploy --config wrangler.jsonc ../../ee/billing/src/worker.ts",
    "deploy:hosted:preview": "WRANGLER_CI_OVERRIDE_NETWORK_MODE_HOST=1 wrangler versions upload --config wrangler.jsonc ../../ee/billing/src/worker.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false",
    "vapid": "node scripts/vapid.mjs",
    "sandbox:image": "node scripts/sandbox-image.mjs"
  },
  "dependencies": {
    "@myrel/db": "workspace:*",
    "@myrel/protocol": "workspace:*",
    "@myrel/runner-core": "workspace:*",
    "agents": "0.28.1",
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261019.1",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
