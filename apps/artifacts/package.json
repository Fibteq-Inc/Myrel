{
  "name": "@altair/artifacts",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788 --persist-to ../api/.wrangler/state",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "typecheck": "tsc",
    "test": "vitest run",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false"
  },
  "dependencies": {
    "@altair/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261019.1",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
