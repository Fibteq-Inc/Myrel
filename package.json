{
  "name": "myrel",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@myrel/api",
    "deploy": "pnpm --filter @myrel/api run deploy",
    "deploy:preview": "pnpm --filter @myrel/api run deploy:preview",
    "deploy:hosted": "pnpm --filter @myrel/api run deploy:hosted",
    "deploy:hosted:preview": "pnpm --filter @myrel/api run deploy:hosted:preview",
    "deploy:api": "pnpm run deploy",
    "deploy:api:preview": "pnpm run deploy:preview",
    "deploy:artifacts": "pnpm --filter @myrel/artifacts run deploy",
    "deploy:artifacts:preview": "pnpm --filter @myrel/artifacts run deploy:preview",
    "deploy:docs": "pnpm --filter @myrel/docs run deploy",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:changed": "turbo run typecheck test --affected",
    "db:generate": "pnpm --filter @myrel/db generate",
    "db:migrate:local": "pnpm --filter @myrel/api exec wrangler d1 migrations apply myrel --local"
  },
  "devDependencies": {
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "wrangler": "^4.151.2"
  }
}
