{
  "name": "altair",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@altair/api",
    "deploy": "pnpm --filter @altair/api run deploy",
    "deploy:preview": "pnpm --filter @altair/api run deploy:preview",
    "deploy:artifacts": "pnpm --filter @altair/artifacts run deploy",
    "deploy:artifacts:preview": "pnpm --filter @altair/artifacts run deploy:preview",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @altair/db generate",
    "db:migrate:local": "pnpm --filter @altair/api exec wrangler d1 migrations apply altair --local"
  },
  "devDependencies": {
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "wrangler": "^4.151.2"
  }
}
